#!/bin/bash
#PBS -N ngcm_missing
#PBS -A UCHI0018
#PBS -q develop
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=1:mem=64GB
#PBS -j oe
#PBS -o /glade/work/bgong/MJO_results/logs/ngcm_missing.log

set -euo pipefail
DATES_FILE=/glade/work/bgong/MJO_modular/run_scripts/ngcm_campaign_missing_dates.txt
PY=/glade/work/bgong/mjocast_env/bin/python
REPO=/glade/work/bgong/MJO_modular

cd "${REPO}"
echo "=== NGCM missing dates step2 ==="
echo "Start: $(date)"

while IFS= read -r date; do
    [ -z "$date" ] && continue
    OUT=/glade/campaign/univ/uchi0018/bing/mjo/ngcm_campaign/chi200_1p0deg/forecast_files/chi200_forecast_${date}.nc
    if [ -f "$OUT" ]; then echo "Skipping $date"; continue; fi
    echo "Processing $date ..."
    ${PY} src/step2_prepare_forecasts.py --config config/pipeline_config.yaml \
        --dataset ngcm_campaign --date "$date"
done < "${DATES_FILE}"

echo "=== Step4 ==="
${PY} src/step4_run_forecasts.py --config config/pipeline_config.yaml \
    --dataset ngcm_campaign

echo "All done: $(date)"

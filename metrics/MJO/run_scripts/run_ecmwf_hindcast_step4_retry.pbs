#!/bin/bash
#PBS -N ecmwf_hc_s4
#PBS -q develop
#PBS -l select=1:ncpus=1:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -A UCHI0014

# Step4 only (forecast_files already exist) for the 15 retry dates.

set -euo pipefail

REPO_ROOT=/glade/work/bgong/MJO_modular
CONFIG=${REPO_ROOT}/config/pipeline_config.yaml
PY=/glade/work/bgong/mjocast_env/bin/python

echo "=== ECMWF hindcast step4 retry ==="
echo "Host  : $(hostname)"
echo "Start : $(date)"

DATE_ARGS=""
while IFS= read -r date; do
    DATE_ARGS="${DATE_ARGS} --date ${date}"
done < ${REPO_ROOT}/run_scripts/ecmwf_hindcast_step4_retry.txt

cd "${REPO_ROOT}"
${PY} src/step4_run_forecasts.py --config "${CONFIG}" --dataset ecmwf_s2s ${DATE_ARGS}

echo "Done: $(date)"

#!/bin/bash
#PBS -N mjo_step2_array
#PBS -q main
#PBS -l select=1:ncpus=1:mem=64GB
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -A UCHI0018
#PBS -m e
#
# PBS array job for step 2 (prepare forecast files).
# Each array element processes a slice of init dates for all enabled datasets.
#
# Usage:
#   # Edit DATES_FILE to point to a text file with one YYYYMMDD per line.
#   # Then submit as a PBS array job sized to the number of date groups:
#
#   NDATES=$(wc -l < dates_to_process.txt)
#   NJOBS=$(( (NDATES + CHUNK - 1) / CHUNK ))
#   qsub -J 0-$((NJOBS-1)) run_scripts/run_step2_array.pbs
#
# Environment variables (set before qsub or override here):
#   DATES_FILE  : path to file listing YYYYMMDD init dates (one per line)
#   CONFIG      : path to pipeline_config.yaml
#   CHUNK       : number of dates per array task (default 8)

set -euo pipefail

REPO_ROOT=/glade/work/bgong/MJO_modular
CONFIG=${CONFIG:-${REPO_ROOT}/config/pipeline_config.yaml}
CHUNK=${CHUNK:-8}
DATASET=${DATASET:-}

# Default dates file: all dates from fuxi_s2s loader
DATES_FILE=${DATES_FILE:-${REPO_ROOT}/run_scripts/all_dates.txt}

if [ ! -f "${DATES_FILE}" ]; then
    echo "ERROR: DATES_FILE not found: ${DATES_FILE}"
    echo "Generate it with:"
    echo "  ls /glade/derecho/scratch/bgong/fuxi_s2s/*.7z | xargs -I{} basename {} .7z | sort > run_scripts/all_dates.txt"
    exit 1
fi

CONDA_ENV=$(python3 -c "
import yaml
c = yaml.safe_load(open('${CONFIG}'))
print(c.get('conda_env', '/glade/work/bgong/mjocast_env'))
" 2>/dev/null || echo "/glade/work/bgong/mjocast_env")
PY="${CONDA_ENV}/bin/python"

# compute slice for this array element
TASK_ID=${PBS_ARRAY_INDEX:-0}
START=$(( TASK_ID * CHUNK + 1 ))
END=$(( START + CHUNK - 1 ))

echo "=== Step 2 array task ${TASK_ID} (dates ${START}–${END}) ==="
echo "Host   : $(hostname)"
echo "Config : ${CONFIG}"
echo "Start  : $(date)"

# extract this task's dates
DATE_ARGS=""
while IFS= read -r date; do
    DATE_ARGS="${DATE_ARGS} --date ${date}"
done < <(sed -n "${START},${END}p" "${DATES_FILE}")

if [ -z "${DATE_ARGS}" ]; then
    echo "No dates for this task — exiting."
    exit 0
fi

cd "${REPO_ROOT}"
DATASET_ARG=""
[ -n "${DATASET}" ] && DATASET_ARG="--dataset ${DATASET}"
${PY} src/step2_prepare_forecasts.py --config "${CONFIG}" ${DATASET_ARG} ${DATE_ARGS}

echo "Done: $(date)"

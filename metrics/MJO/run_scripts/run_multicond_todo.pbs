#!/bin/bash
#PBS -N multicond_todo
#PBS -q develop
#PBS -l select=1:ncpus=1:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -A UCHI0014

# Step2 + step4 for remaining multicond dates.
# Submit:
#   qsub -J 0-2 -v CHUNK=10 run_scripts/run_multicond_todo.pbs

set -euo pipefail

REPO_ROOT=/glade/work/bgong/MJO_modular
CONFIG=${REPO_ROOT}/config/pipeline_config.yaml
DATES_FILE=${REPO_ROOT}/run_scripts/multicond_todo.txt
CHUNK=${CHUNK:-10}
PY=/glade/work/bgong/mjocast_env/bin/python

TASK_ID=${PBS_ARRAY_INDEX:-0}
START=$(( TASK_ID * CHUNK + 1 ))
END=$(( START + CHUNK - 1 ))

echo "=== multicond todo  task=${TASK_ID}  lines=${START}-${END} ==="
echo "Host: $(hostname)  Start: $(date)"

DATE_ARGS=""
while IFS= read -r date; do
    DATE_ARGS="${DATE_ARGS} --date ${date}"
done < <(sed -n "${START},${END}p" "${DATES_FILE}")

if [ -z "${DATE_ARGS}" ]; then
    echo "No dates for this task — exiting."
    exit 0
fi

cd "${REPO_ROOT}"
${PY} src/step2_prepare_forecasts.py --config "${CONFIG}" --dataset uc_s2s_multicond_2019 ${DATE_ARGS}
${PY} src/step4_run_forecasts.py     --config "${CONFIG}" --dataset uc_s2s_multicond_2019 ${DATE_ARGS}

echo "Done: $(date)"

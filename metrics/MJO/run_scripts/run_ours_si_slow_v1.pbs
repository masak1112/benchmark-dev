#!/bin/bash
#PBS -N si_slow_v1_mjo
#PBS -A UCHI0018
#PBS -q develop
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=1:mem=64GB
#PBS -j oe
#PBS -o /glade/work/bgong/MJO_results/logs/si_slow_v1_mjo.log

set -euo pipefail
PY=/glade/work/bgong/mjocast_env/bin/python
REPO=/glade/work/bgong/MJO_modular

cd "${REPO}"
echo "=== UC-S2S v3 (slow_v1) step2 ==="
echo "Start: $(date)"

${PY} src/step2_prepare_forecasts.py --config config/pipeline_config.yaml \
    --dataset ours_si_slow_v1

echo "=== Step4 ==="
${PY} src/step4_run_forecasts.py --config config/pipeline_config.yaml \
    --dataset ours_si_slow_v1

echo "All done: $(date)"

#!/bin/bash
#PBS -N mjo_step4_step5
#PBS -q develop
#PBS -l select=1:ncpus=1:mem=64GB
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -A UCHI0018
#PBS -m e
#
# PBS job for step 4 (RMM projection) and step 5 (skill plots).
# Typically submitted after the step2 array job completes:
#
#   STEP2_ID=$(qsub -J 0-N run_scripts/run_step2_array.pbs)
#   qsub -W depend=afterokarray:${STEP2_ID} run_scripts/run_step4_step5.pbs
#
# Or run independently once step 2 is done:
#   qsub run_scripts/run_step4_step5.pbs

set -euo pipefail

REPO_ROOT=/glade/work/bgong/MJO_modular
CONFIG=${CONFIG:-${REPO_ROOT}/config/pipeline_config.yaml}

CONDA_ENV=$(python3 -c "
import yaml
c = yaml.safe_load(open('${CONFIG}'))
print(c.get('conda_env', '/glade/work/bgong/mjocast_env'))
" 2>/dev/null || echo "/glade/work/bgong/mjocast_env")
PY="${CONDA_ENV}/bin/python"

echo "=== Step 4+5 job ==="
echo "Host   : $(hostname)"
echo "Config : ${CONFIG}"
echo "Start  : $(date)"

cd "${REPO_ROOT}"

echo ""
echo ">>> Step 3: Compute observed EOFs (if obs not already computed)"
${PY} src/step3_process_eofs.py --config "${CONFIG}"

echo ""
echo ">>> Step 4: Run MJOcast RMM projection"
${PY} src/step4_run_forecasts.py --config "${CONFIG}"
echo "Step 4 complete: $(date)"

echo ""
echo ">>> Step 5a: Bivariate ACC skill curve"
${PY} src/step5_acc_plot.py --config "${CONFIG}"

echo ""
echo ">>> Step 5b: RMM phase space plots"
${PY} src/step5_phase_space.py --config "${CONFIG}"

echo ""
echo "=== Step 4+5 complete: $(date) ==="

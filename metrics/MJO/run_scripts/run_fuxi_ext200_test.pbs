set -euo pipefail
PY=/glade/work/bgong/mjocast_env/bin/python
cd /glade/work/bgong/MJO_modular
D=20190509
echo "step2 start $(date)"
${PY} src/step2_prepare_forecasts.py --config config/pipeline_config.yaml --dataset fuxi_s2s_ext200 --date $D
echo "step4 start $(date)"
${PY} src/step4_run_forecasts.py --config config/pipeline_config.yaml --dataset fuxi_s2s_ext200 --date $D
echo "done $(date)"
